class Solution {
public:
    int findCheapestPrice(int n, vector<vector<int>>& flights, int src, int dst, int k) {
        vector<vector<pair<int,int>>> adj(n);
        for(int i=0;i<flights.size();i++){
            int u=flights[i][0];
            int v=flights[i][1];
            int w=flights[i][2];
            adj[u].push_back({v,w});
        }
        priority_queue<pair<pair<int,int>,int>,
        vector<pair<pair<int,int>,int>>,
        greater<pair<pair<int,int>,int>>> pq;
        pq.push({{0,src},0});

        vector<int> dist(n,INT_MAX);
        dist[src]=0;

        while(!pq.empty()){
            pair<pair<int,int>,int> result=pq.top();
            pq.pop();
            int step=result.first.first;
            int node=result.first.second;
            int weight=result.second;

            for(auto& i:adj[node]){
                int edgenode=i.first;
                int edgeweight=i.second;
                int newdist=edgeweight+weight;

                if(dist[edgenode]>newdist && step<=k){
                    dist[edgenode]=newdist;
                    pq.push({{step+1,edgenode},newdist});
                }
            }
        }
        return (dist[dst]==INT_MAX) ? -1:dist[dst];
    }
};
