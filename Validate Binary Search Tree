void lefttoleft(TreeNode* root,vector<int> &v){
    if(root==NULL)return;
    lefttoleft(root->left,v);
    v.push_back(root->val);
    lefttoleft(root->right,v);
 }
 bool check(vector<int>& v){
        for(int i=1;i<v.size();i++){
        if(v[i-1]<v[i]){
            continue;
        }
        else{
            return false;
        }
    }
    return true;
 }
class Solution {
public:
    bool isValidBST(TreeNode* root) {
        vector<int> v;
        lefttoleft(root,v);
        return check(v);
    }
};
