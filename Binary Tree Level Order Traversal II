class Solution {
public:
    vector<vector<int>> levelOrderBottom(TreeNode* root) {
        vector<vector<int>> v1;
        queue<TreeNode*> q1;
        if(root==NULL)return v1;
        q1.push(root);
        while(!q1.empty()){
            int n=q1.size();
            vector<int> v;
            for(int i=0;i<n;i++){
                TreeNode* temp=q1.front();
                q1.pop();
                v.push_back(temp->val);

                if(temp->left){
                    q1.push(temp->left);
                }
                if(temp->right){
                    q1.push(temp->right);
                }
            }
            v1.push_back(v);
        }
        reverse(v1.begin(),v1.end());
        return v1;
    }
};
