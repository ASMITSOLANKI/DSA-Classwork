class Solution {
public:
    bool isSymmetric(TreeNode* root) {
        if(root==NULL){
            return 0;
        }
        queue<TreeNode*> q1;
        q1.push(root);
        while(!q1.empty()){
            int n=q1.size();
            vector<int> v1;
            for(int i=0;i<n;i++){
                TreeNode* temp=q1.front();
                q1.pop();

                if(temp){
                    v1.push_back(temp->val);
                    q1.push(temp->left);
                    q1.push(temp->right);
                }
                else{
                    v1.push_back(-3000);
                }
            }
            int st=0;
            int end=v1.size()-1;
            while(st<end){
                if(v1[st]!=v1[end]){
                    return false;
                }
                st++;
                end--;
            }
        }
        return true;
    }
};
