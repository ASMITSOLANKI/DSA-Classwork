class Solution {
public:
    bool dfs(int node,vector<int>& vis,vector<vector<int>>& adj,vector<int>& path_vis){
        vis[node]=1;
        path_vis[node]=1;

        for(auto& i:adj[node]){
            if(vis[i]==0){
                if(dfs(i,vis,adj,path_vis)==true)return true;
            }
            else if(vis[i]==1 && path_vis[i]==1){
                return true;
            }
        }
        path_vis[node]=0;
        return false;
    }
    bool canFinish(int n, vector<vector<int>>& prerequisites) {
        vector<vector<int>> adj(n);
        for(int i=0;i<prerequisites.size();i++){
            int u=prerequisites[i][0];
            int v=prerequisites[i][1];
            adj[u].push_back(v);
        }
        vector<int> vis(n,0);
        vector<int> path_vis(n,0);
        for(int i=0;i<n;i++){
            if(vis[i]==0){
                if(dfs(i,vis,adj,path_vis))return false;
            }
        }
        return true;
    }
};
